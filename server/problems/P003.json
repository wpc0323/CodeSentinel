 },
 "solution": "import sys\nfrom datetime import date, timedelta\ndef main():\n    y, m, d, k = map(int, sys.stdin.buffer.read().split())\n    r = date(y, m, d) + timedelta(days=k)\n    print(\"%04d-%02d-%02d\" % (r.year, r.month, r.day))\nmain()\n"
}