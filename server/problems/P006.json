 "solution": "import sys\ndef main():\n    data = sys.stdin.buffer.read().split()\n    n, W = int(data[0]), int(data[1])\n    dp = [0] * (W + 1)\n    idx = 2\n    for _ in range(n):\n        w = int(data[idx]); v = int(data[idx + 1]); idx += 2\n        for c in range(W, w - 1, -1):\n            if dp[c - w] + v > dp[c]:\n                dp[c] = dp[c - w] + v\n    print(dp[W])\nmain()\n"
}