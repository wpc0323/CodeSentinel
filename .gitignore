# ============================================================
# 依赖与包管理：虚拟环境与 Python 缓存产物
# ============================================================
# 虚拟环境目录，由 pip/venv 在本机生成，体积大且不跨平台，不应入库
.venv/
# Python 运行时自动生成的字节码缓存目录，纯产物可重建，入库无意义
__pycache__/
# 编译后的字节码文件（__pycache__ 之外散落的 .pyc）
*.pyc
# pytest 的缓存目录，仅本机测试加速用，非源码
.pytest_cache/

# ============================================================
# 敏感信息：密钥、令牌、私有配置
# ============================================================
# 环境变量文件，常含 DASHSCOPE_API_KEY 等密钥，泄露有安全风险，必须忽略
.env
# 实验私有配置（真实密钥、模型参数），已在仓库保留 config.example.json 模板替代
experiment/config.json
# 仓库只保留 config.example.json 模板；密钥应通过环境变量提供

# ============================================================
# 构建与本地产物：日志、临时调试、运行时数据、实验输出
# ============================================================
# 通用日志文件
*.log
# 服务运行产生的日志
server.log
server_err.log
# 运行时 SQLite 数据库，由 store.init_db() 首次启动自动建表生成，
# 内含提交记录/实验运行数据等可重建产物，且每人本机各自生成，入库易冲突/泄露
data/
# 实验分析报告输出目录，由 analyze.py 生成，属派生产物
report/

# 临时验证/调试文件（命名以下划线开头，不入库）
# 本地随手验证/截图/调试用的临时文件，非项目源码，避免误提交
_*.png
_*.html
_*.py

# 操作系统垃圾
# macOS 生成的隐藏文件
.DS_Store
# Windows 资源管理器生成的缩略图缓存文件
Thumbs.db
