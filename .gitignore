# ============================================================
# 依赖与包管理：虚拟环境与 Python 缓存产物
# ============================================================
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ============================================================
# 敏感信息：密钥、令牌、私有配置
# ============================================================
.env
experiment/config.json
# 仓库只保留 config.example.json 模板；密钥应通过环境变量提供

# ============================================================
# 构建与本地产物：日志、临时调试、运行时数据、实验输出
# ============================================================
*.log
server.log
server_err.log
data/
report/

# 临时验证/调试文件（命名以下划线开头，不入库）
_*.png
_*.html
_*.py

# 操作系统垃圾
.DS_Store
Thumbs.db
